#!/usr/bin/env bash
# The last gate before something leaves this machine.
#
# It checks the COMMITS BEING PUSHED, not only the working tree, and that distinction is the
# whole reason it exists separately from `pre-commit`: an earlier `filter-branch --env-filter`
# rewrote every author line, `git log` read clean, and the old content sat untouched in
# every earlier version of the files. An `--env-filter` never touches a blob.
#
# Install once per clone:
#
#     git config core.hooksPath .githooks
set -u

root=$(git rev-parse --show-toplevel)
. "$root/.githooks/_python.sh"
py=$(find_python) || {
    echo "  guard: no working python was found, so NOTHING WAS CHECKED. This is not a pass." >&2
    echo "  Install python, or run the checks yourself: python tools/guard.py --tree" >&2
    exit 1
}
zero=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        # A NEW REF, WHICH IS USUALLY A TAG, AND "everything reachable from it" MADE RELEASES
        # IMPOSSIBLE. A tag points at a commit the remote already has, so that range re-judged
        # the entire published history -- and this history contains one commit, already on
        # `origin/main` since August, whose message quotes the `+03:00` it was removing. See
        # `scan_messages`, which records it: a force-push would not have helped, because GitHub
        # keeps the orphan reachable by its sha and every clone keeps everything.
        #
        # So `git push origin v0.2.0` refused, permanently, for text that left this machine
        # months ago. A gate that cannot be satisfied by any action is the one people learn to
        # pass `--no-verify` to, which is exactly what the refusal text tells them never to do.
        #
        # What leaves this machine is what the remote does NOT have, and that is what is
        # checked. A genuinely new branch still gets every one of its own commits read; if
        # nothing has been fetched, `--remotes=origin` names nothing and the range widens back
        # to everything, which is the safe direction to be wrong in.
        range="$local_sha --not --remotes=origin"
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    $py "$root/tools/guard.py" --range "$range" || status=1
done

# NO REFS ON STDIN means git had nothing to tell us, not that there is nothing to check —
# `git push` with no new commits, or a hook invoked by hand. Check the tree rather than exit 0
# on an empty read, because "nothing arrived" reading as "nothing is wrong" is the failure this
# whole project is named after.
if [ "$status" = "0" ]; then
    # shellcheck disable=SC2086
    $py "$root/tools/guard.py" --tree || status=1
fi
exit "$status"
